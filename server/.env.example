NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/furnicraft_db?retryWrites=true&w=majority
JWT_SECRET=super_secret_jwt_key_furnicraft_2026_dev_minimum_32_characters
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
COOKIE_DOMAIN=localhost

# ==============================================================
# Email & OTP Password Recovery Configuration (Nodemailer)
# ==============================================================
# For local development with Gmail:
# 1. Enable 2-Step Verification on your Google Account:
#    https://myaccount.google.com/security
# 2. Generate a 16-character Google App Password:
#    Google Account -> Security -> 2-Step Verification -> App Passwords
# 3. Set EMAIL_SERVICE=gmail and enter your Gmail address and 16-char App Password.
# 4. NEVER use your primary Google account password or commit real credentials.

EMAIL_SERVICE=gmail
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
EMAIL_FROM="FurniCraft" <no-reply@furnicraft.com>

# Optional Custom Transactional SMTP (SendGrid, Mailgun, Amazon SES, Postmark, etc.)
# If using a custom SMTP host rather than Gmail:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=your_sendgrid_api_key

# ==============================================================
# SMS & Thekedar Registration OTP Configuration (Optional)
# ==============================================================
# Supported providers: 'twilio' | 'fast2sms' | 'msg91' | 'console' (default: 'console' in dev/test)
SMS_PROVIDER=console
REQUIRE_REGISTRATION_OTP=false

# Twilio SMS Gateway (Used when SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Fast2SMS Gateway (India) (Used when SMS_PROVIDER=fast2sms)
FAST2SMS_API_KEY=your_fast2sms_api_key

# MSG91 SMS Gateway (Used when SMS_PROVIDER=msg91)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=FURNIC
MSG91_TEMPLATE_ID=your_template_id


